# Copia a .env.local y pon los valores que imprime `supabase status`.
# .env.local está fuera de git.
#
# Las llaves son `publishable` y `secret`, no las viejas `anon` y `service_role`
# (ADR 0006). La `secret` NUNCA va en código que llegue al navegador: por eso no
# lleva el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


# OpenRouter, para el corte de la captura (`src/captura/lectura-ia.ts`).
#
# **Opcional.** Sin llave la captura funciona igual: se usa la segmentación y se
# le pregunta a la persona por las cinco partes en vez de solo por las que le
# falten. `IA-01` lo exige — la recepción no puede depender de un tercero.
#
# Es el proveedor que este proyecto ya usó para analizar sus propios documentos
# fuente (`negocio/fuentes-2026-09-11/`). Si están las dos llaves, manda esta.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: con él, Next la inyecta literalmente en
# el bundle del navegador y cualquiera la lee desde el inspector.
#
# La llave se saca en https://openrouter.ai/keys
# **Revisa la política de datos de la cuenta.** Lo que se manda son relatos de
# ciudadanos, y OpenRouter enruta a proveedores distintos según el modelo.
OPENROUTER_API_KEY=
# Opcional. Por defecto: mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_MODELO=

# Mistral directo, como suelo si no hay OpenRouter. (`src/captura/lectura-ia.ts`).
#
# **Opcional.** Sin esto la captura funciona igual: se usa la segmentación, y
# hay pruebas que lo comprueban borrando la llave. `IA-01` lo exige — la
# recepción no puede depender de un tercero.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: con él, Next la inyecta literalmente en
# el bundle del navegador y cualquiera la lee desde el inspector.
#
# La llave se saca en https://console.mistral.ai/api-keys
# **Mira de qué plan es: el gratuito «Experiment» entrena con lo que le mandes**,
# y lo que se le manda aquí son relatos de ciudadanos.
MISTRAL_API_KEY=

# El flujo de n8n que llama a quien pidió «Te llamamos» (`INT-02`).
#
# **Opcional.** Sin esto se usa la dirección acordada, que está en el código:
# `https://n8n.srv891132.hstgr.cloud/webhook/dnp`. Se sobrescribe para apuntar a
# otro servidor —o a uno de mentira— sin tocar código.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: esto corre en el servidor y la dirección
# no tiene por qué llegar al navegador.
LLAMADA_WEBHOOK_URL=

# Apaga el aviso del todo, sin tocar el guardado. Lo usan los recorridos:
# sin esto cada corrida dispara el flujo de verdad, y ese flujo llama a gente.
SIN_WEBHOOK=0

# La puerta de la consola y la administración (`src/acceso/`, `src/middleware.ts`).
#
# **Las dos, o nadie entra.** Sin alguna de las dos el login contesta que el
# acceso no está configurado, y `/consola` y `/administracion` mandan siempre
# al login: una puerta que se abre sola cuando falta la configuración se abre
# sola el día que alguien se equivoca en Vercel.
#
# ACCESS_TOKEN es el que se escribe en `/ingresar`, y lo conoce el equipo.
# Cambiarlo cierra todas las sesiones abiertas.
#
# JWT_SECRET firma las sesiones y no lo conoce nadie: **no es el mismo valor**
# que ACCESS_TOKEN, y tiene que tener al menos 32 caracteres. Se genera con
#   openssl rand -base64 48
#
# Sin prefijo NEXT_PUBLIC_ ninguna de las dos: con él, Next las mete en el
# bundle del navegador y cualquiera las lee desde el inspector.
ACCESS_TOKEN=
JWT_SECRET=
