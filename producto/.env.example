# Copia a .env.local y pon los valores que imprime `supabase status`.
# .env.local está fuera de git.
#
# Las llaves son `publishable` y `secret`, no las viejas `anon` y `service_role`
# (ADR 0006). La `secret` NUNCA va en código que llegue al navegador: por eso no
# lleva el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mistral, para el corte de la captura (`src/captura/lectura-ia.ts`).
#
# **Opcional.** Sin esto la captura funciona igual: se usa la segmentación, y
# hay pruebas que lo comprueban borrando la llave. `IA-01` lo exige — la
# recepción no puede depender de un tercero.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: con él, Next la inyecta literalmente en
# el bundle del navegador y cualquiera la lee desde el inspector.
#
# La llave se saca en https://console.mistral.ai/api-keys
# **Mira de qué plan es: el gratuito «Experiment» entrena con lo que le mandes**,
# y lo que se le manda aquí son relatos de ciudadanos.
MISTRAL_API_KEY=
