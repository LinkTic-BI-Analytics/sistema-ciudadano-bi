{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_server_cache_lru_cross_request_lru_caching", "label": "Cross-Request LRU Caching", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact HIGH. React.cache() dies with the request, so sequential user actions hitting different endpoints for the same data re-query; a module-level LRUCache with max size and TTL survives between requests. Trade-off is runtime-dependent: it only pays off where instances are reused (Fluid Compute), while isolated serverless invocations need Redis instead."}, {"id": "_agents_skills_vercel_react_best_practices_rules_server_cache_lru_fluid_compute", "label": "Fluid Compute Instance Reuse", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent requests share one function instance, so in-process caches persist without external storage; this is what makes the LRU approach viable without Redis."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_server_cache_lru_cross_request_lru_caching", "target": "_agents_skills_vercel_react_best_practices_rules_server_cache_react_per_request_deduplication_react_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-lru.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_server_cache_lru_cross_request_lru_caching", "target": "_agents_skills_vercel_react_best_practices_rules_server_cache_lru_fluid_compute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-lru.md", "source_location": null, "weight": 1.0}], "hyperedges": []}