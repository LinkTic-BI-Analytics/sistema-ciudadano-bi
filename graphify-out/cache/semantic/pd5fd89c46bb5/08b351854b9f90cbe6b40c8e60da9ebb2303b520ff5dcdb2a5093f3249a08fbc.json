{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_split_combined_hooks_split_combined_hook_computations", "label": "Split Combined Hook Computations", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-split-combined-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. One hook holding independent tasks takes the union of their dependencies, so any change reruns everything (changing sortOrder redoes filtering). Splitting lets each step recompute only on its own inputs, and chaining feeds the memoized intermediate into the next. Same applies to unrelated side effects in one useEffect."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_split_combined_hooks_split_combined_hook_computations", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_react_compiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-split-combined-hooks.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_rerender_split_combined_hooks_split_combined_hook_computations", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_dependencies_narrow_effect_dependencies", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-split-combined-hooks.md", "source_location": null, "weight": 1.0}], "hyperedges": []}