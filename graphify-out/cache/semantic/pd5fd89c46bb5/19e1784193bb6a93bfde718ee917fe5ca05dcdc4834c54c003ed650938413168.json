{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "label": "Use Functional setState Updates", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. Reading state directly forces it into the dependency array, so the callback is recreated on every change and re-renders memoized children; omitting it instead produces a stale closure. The updater form removes the dependency entirely, giving stable references and always-latest state. Direct updates stay fine for static values or values from props/arguments."}, {"id": "_agents_skills_vercel_react_best_practices_rules_rerender_functional_setstate_stale_closure", "label": "Stale Closure Bug", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A callback memoized with a missing dependency keeps capturing the initial state value forever; described here as the most common source of React closure bugs."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_functional_setstate_stale_closure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_react_compiler", "relation"