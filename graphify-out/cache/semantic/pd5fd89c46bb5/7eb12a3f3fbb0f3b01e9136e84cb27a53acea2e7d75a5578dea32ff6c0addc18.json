{"nodes": [{"id": "negocio_requisitos_normalizacion_para_agrupar_v1", "label": "Normalizaci\u00f3n para poder agrupar (requisito v1)", "file_type": "document", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_linea_de_alimentacion_snp", "label": "L\u00ednea de alimentaci\u00f3n al sistema nacional de planeaci\u00f3n", "file_type": "concept", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una l\u00ednea de alimentaci\u00f3n entrega hechos con atributos comparables, no relatos sueltos."}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_lo_derivado_nunca_sustituye_lo_dicho", "label": "Lo derivado nunca sustituye lo dicho", "file_type": "rationale", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lectura declarada al lado del texto: rango y no cifra, original visible, vac\u00eda cuando no se puede decir. Un rango inventado es una mentira que alguien usa para decidir presupuesto (I2, ADR 0012, N03)."}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_nor_01", "label": "NOR-01 \u00b7 Hace cu\u00e1nto: un rango, nunca una fecha", "file_type": "concept", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_nor_02", "label": "NOR-02 \u00b7 A cu\u00e1ntos: un rango, nunca un n\u00famero", "file_type": "concept", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El rango es menos preciso a prop\u00f3sito: el n\u00famero declarado identifica (Q11, C2). Se a\u00f1adieron varios_municipios y todo_el_municipio porque que algo deje de ser local cambia a qui\u00e9n compete."}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_nor_03", "label": "NOR-03 \u00b7 El aporte en dos l\u00edneas, con sus palabras al lado", "file_type": "concept", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_nor_04", "label": "NOR-04 \u00b7 Filtrar por cruce sin inventar un ranking", "file_type": "concept", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El municipio con m\u00e1s aportes tiene m\u00e1s gente con tel\u00e9fono, no necesariamente m\u00e1s necesidad (BI-02). El BI lo construye otro equipo."}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_nor_05", "label": "NOR-05 \u00b7 Lo derivado se puede corregir, y se ve que se corrigi\u00f3", "file_type": "concept", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_normalizacion_para_agrupar_v1_fallar_hacia_sin_decir", "label": "Fallar hacia sin_decir", "file_type": "rationale", "source_file": "negocio/requisitos/normalizacion-para-agrupar-v1.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La base tiene un solo aporte humano; mejor una bandeja que admite que no sabe que una que agrupa mal y nadie lo nota."}], "edges": [{"source": "negocio_requisitos_normalizacion_para_agru