{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_js_request_idle_callback_defer_non_critical_work", "label": "Defer Non-Critical Work with requestIdleCallback", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/js-request-idle-callback.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analytics, recent-search persistence and prefetching block the main thread if run inline with a user interaction; scheduling them in idle periods keeps interactions and animations smooth. A timeout option bounds the delay for work that must still happen; large datasets are chunked against deadline.timeRemaining() in sub-50ms slices; setTimeout(cb, 1) is the fallback where requestIdleCallback is unsupported. Explicitly NOT for user-initiated feedback, awaited render updates or time-sensitive work. Impact MEDIUM."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_js_request_idle_callback_defer_non_critical_work", "target": "_agents_skills_vercel_react_best_practices_rules_rendering_content_visibility_css_content_visibility_for_long_lists", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/js-request-idle-callback.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_js_request_idle_callback_defer_non_critical_work", "target": "_agents_skills_vercel_react_best_practices_rules_js_cache_storage_cache_storage_api_calls", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/js-request-idle-callback.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_js_request_idle_callback_defer_non_critical_work", "target": "_agents_skills_ver