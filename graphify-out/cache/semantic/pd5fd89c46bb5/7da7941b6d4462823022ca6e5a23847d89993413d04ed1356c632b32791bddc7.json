{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_lazy_state_init_lazy_state_initialization", "label": "Use Lazy State Initialization", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-lazy-state-init.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. An inline initializer expression is evaluated on every render although React only uses it once; passing a function defers it to the first render. Worth it for storage reads, index/map building, DOM reads and heavy transforms; unnecessary for primitives, prop passthrough or cheap literals."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_lazy_state_init_lazy_state_initialization", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_simple_expression_in_memo_no_usememo_for_simple_primitive_expression", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-lazy-state-init.md", "source_location": null, "weight": 1.0}], "hyperedges": []}