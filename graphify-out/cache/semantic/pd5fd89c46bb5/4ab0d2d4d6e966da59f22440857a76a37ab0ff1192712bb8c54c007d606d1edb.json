{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_derived_state_no_effect_calculate_derived_state_during_rendering", "label": "Calculate Derived State During Rendering", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. Storing a computable value in state plus an effect costs an extra render pass and lets the stored copy drift from its sources. Derive during render; for resets on prop change prefer a key instead of setState in an effect. Cited source: React docs 'You Might Not Need an Effect'."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_derived_state_no_effect_calculate_derived_state_during_rendering", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_derived_state_subscribe_to_derived_state", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_rerender_derived_state_no_effect_calculate_derived_state_during_rendering", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_move_effect_to_event_interaction_logic_in_event_handlers", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "effect_hygiene_rules", "label": "Effect Hygiene: Keep Work Out of useEffect", "nodes": ["_agents_skills_vercel_react_best_practices_rules_rerender_dependencies_narrow_effect_dependencies", "_agents_skills_vercel_react_best_practices_rules_re