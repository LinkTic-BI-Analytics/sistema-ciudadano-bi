{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_rls_performance", "label": "Optimizing RLS Policies for Performance", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": "## Optimize RLS Policies for Performance", "rationale": "A bare auth.uid() in a USING clause is evaluated once per row; wrapping it in a scalar subselect lets the planner evaluate and cache it once, claimed at 100x+ on large tables. Columns referenced by policies must also be indexed, since every query now carries that predicate.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_security_definer_function", "label": "SECURITY DEFINER Helper Functions for RLS", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": "Use security definer functions for complex checks", "rationale": "Running with the creator's privileges bypasses RLS on the tables the function reads, which is exactly what makes a membership lookup cheap and exactly what makes it dangerous: the trade-off is paid for with an explicit auth.uid() check inside the body, a non-exposed schema, and REVOKE EXECUTE from anon/authenticated/service_role.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_rls_performance", "target": "_agents_skills_supabase_postgres_best_practices_references_security_rls_basics_row_level_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": "create policy orders_policy on orders", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_security_definer_function", "target": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_rls_performance", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": "Use security definer functions for complex checks", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_security_definer_function", "target": "_agents_skills_supabase_postgres_best_practices_references_security_privileges_least_privilege", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": "revoke execute on function private.is_team_member(bigint) from PUBLIC, anon, authenticated, service_role;", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references_security_rls_performance_rls_performance", "target": "_agents_skills_supabase_postgres_best_practices_references_query_missing_indexes_where_join_indexes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-rls-performance.md", "source_location": "Always add indexes on columns used in RLS policies", "weight": 1.0}], "hyperedges": []}