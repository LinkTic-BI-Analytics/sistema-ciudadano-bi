{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_conn_limits_connection_limits", "label": "Set Appropriate Connection Limits", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/conn-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact CRITICAL. Each connection costs 1-3MB RAM, so raising max_connections blindly (500 on 4GB) burns a gigabyte on connections alone and causes OOM under load; practical ceiling is 100-200, and work_mem * max_connections must stay under 25% of RAM."}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_conn_limits_connection_limits", "target": "_agents_skills_supabase_postgres_best_practices_references_conn_pooling_connection_pooling", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/supabase-postgres-best-practices/references/conn-limits.md", "source_location": null, "weight": 1.0}], "hyperedges": []}