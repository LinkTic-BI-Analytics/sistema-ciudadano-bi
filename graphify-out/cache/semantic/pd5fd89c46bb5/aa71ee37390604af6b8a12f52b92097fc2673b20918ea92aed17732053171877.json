{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_data_batch_inserts_batch_inserts", "label": "Batch INSERT Statements for Bulk Data", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/data-batch-inserts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM, 10-50x faster: each single-row INSERT is its own transaction and round trip, so 1000 rows cost 1000 round trips; a multi-VALUES statement of up to ~1000 rows collapses that to one."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_data_batch_inserts_copy_bulk_load", "label": "COPY for Bulk Loading", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/data-batch-inserts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COPY (from file or stdin, CSV format) is the fastest path for large imports, beyond what multi-row INSERT achieves."}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_data_batch_inserts_batch_inserts", "target": "_agents_skills_supabase_postgres_best_practices_references_data_batch_inserts_copy_bulk_load", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/data-batch-inserts.md", "source_location": "line 38", "weight": 1.0}], "hyperedges": []}