{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state", "label": "Avoid Shared Module State for Request Data", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact HIGH. Server renders run concurrently in one process, so module scope is process-wide shared memory, not request-local: mutable module variables holding request data cause race conditions, cross-request contamination and security leaks between users. Safe exceptions are immutable static assets/config, correctly keyed cross-request caches, and singletons holding no request- or user-specific mutable data."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state", "target": "_agents_skills_vercel_react_best_practices_rules_server_hoist_static_io_hoist_static_io", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-no-shared-module-state.md", "source_location": "line 50: link to ./server-hoist-static-io.md", "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state", "target": "_agents_skills_supabase_postgres_best_practices_references_data_upsert_upsert_on_conflict", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "weight": 1.0}], "hyperedges": []}