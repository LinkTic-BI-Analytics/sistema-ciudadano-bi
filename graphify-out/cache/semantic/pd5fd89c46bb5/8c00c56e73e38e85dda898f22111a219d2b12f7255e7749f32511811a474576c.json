{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_index_type_selection", "label": "Choosing the Right Index Type (B-tree, GIN, GiST, BRIN, Hash)", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": "## Choose the Right Index Type for Your Data", "rationale": "The default B-tree only accelerates ordering-based operators; containment, array, full-text, geometric and time-series access patterns each need a different access method, claimed as 10-100x improvement when matched correctly.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_gin_jsonb", "label": "GIN Index for JSONB Containment", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": "Correct (GIN for JSONB)", "rationale": "B-tree cannot support the @> containment operator, so a JSONB predicate degrades to a full table scan; GIN indexes the contained keys and values directly.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_gin_jsonb", "target": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_index_type_selection", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/query-index-types.md", "source_location": "Correct (GIN for JSONB)", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references_query_index_types_index_type_selection", "target": "_agents_skills_supabase_postgres_best_practices_references_query_missing_indexes_where_join_indexes", "relation": "conceptually_related_to", "confidenc