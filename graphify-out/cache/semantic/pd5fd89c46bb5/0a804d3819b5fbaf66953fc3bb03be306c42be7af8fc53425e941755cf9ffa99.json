{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rendering_hydration_no_flicker_prevent_hydration_mismatch_without_flickering", "label": "Prevent Hydration Mismatch Without Flickering", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two failure modes are rejected: reading localStorage during render crashes SSR, and reading it in useEffect renders the default first and flashes. The accepted trade-off is an inline dangerouslySetInnerHTML script that runs synchronously before paint and writes the stored value onto the element by id, so the DOM is already correct when React hydrates. Applies to theme toggles, user preferences and auth state. Impact MEDIUM."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rendering_hydration_no_flicker_prevent_hydration_mismatch_without_flickering", "target": "_agents_skills_vercel_react_best_practices_rules_rendering_hydration_suppress_warning_suppress_expected_hydration_mismatches", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_rendering_hydration_no_flicker_prevent_hydration_mismatch_without_flickering", "target": "_agents_skills_vercel_react_best_practices_rules_js_cache_storage_cache_storage_api_calls", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ssr_first_paint_rules", "label": "SSR first-paint and hydration correctness flow", "nodes": ["_agents_ski