{"nodes": [{"id": "construccion_tareas_t030_los_cinco_eventos_t030", "label": "T030 \u2014 Los cinco eventos de gesti\u00f3n, separados", "file_type": "document", "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El directorio de entidades no existe (Q13) y el plazo tampoco (Q20), as\u00ed que ni destinos catalogados ni alertas de vencimiento entran aqu\u00ed."}, {"id": "construccion_tareas_t030_los_cinco_eventos_cinco_eventos", "label": "Cinco hechos distintos, uno por fila", "file_type": "concept", "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recepci\u00f3n, remisi\u00f3n, decisi\u00f3n, respuesta y siguiente paso. La tentaci\u00f3n es un campo estado con cinco valores, y es el error que RES-01 existe para impedir: con un solo campo no se puede decir que algo fue recibido y remitido pero no respondido. Una remisi\u00f3n no aceptada sigue pendiente (N12, N13), y aceptarla es otra actuaci\u00f3n."}, {"id": "construccion_tareas_t030_los_cinco_eventos_estadodeatencion_derivado", "label": "estadoDeAtencion derivado, nunca almacenado", "file_type": "rationale", "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un campo almacenado se desincroniza de sus hechos, y entonces el tablero afirma algo que la historia contradice."}, {"id": "construccion_tareas_t030_los_cinco_eventos_sin_cierre_por_silencio", "label": "No se cierra por silencio ni se atribuye causalidad", "file_type": "rationale", "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El plazo no existe (Q20), as\u00ed que se muestra \u00absin respuesta registrada\u00bb y la antig\u00fcedad, nunca \u00abvencido\u00bb. Y N14: un proyecto preexistente relacionado es antecedente, no resultado del aporte."}], "edges": [{"source": "construccion_tareas_t030_los_cinco_eventos_t030", "target": "plantillas_tarea_plantilla_tarea", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "weight": 1.0}, {"source": "construccion_tareas_t030_los_cinco_eventos_t030", "target": "construccion_tareas_t026_el_comprobante_canjearcomprobante", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "weight": 1.0}, {"source": "construccion_tareas_t030_los_cinco_eventos_estadodeatencion_derivado", "target": "construccion_tareas_t030_los_cinco_eventos_cinco_eventos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "weight": 1.0}, {"source": "construccion_tareas_t030_los_cinco_eventos_sin_cierre_por_silencio", "target": "construccion_tareas_t030_los_cinco_eventos_t030", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "weight": 1.0}, {"source": "construccion_tareas_t030_los_cinco_eventos_t030", "target": "construccion_tareas_t028_crear_expediente_t028", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "construccion/tareas/T030-los-cinco-eventos.md", "source_location": null, "weight": 1.0}, {"source": "construccion_tareas_t030_los_cinco_eventos_t030", "target": "construccion_tareas_t029_desagrupar_t029", "relation": "conceptually_related_to", "confidence": "EXTRACTED"