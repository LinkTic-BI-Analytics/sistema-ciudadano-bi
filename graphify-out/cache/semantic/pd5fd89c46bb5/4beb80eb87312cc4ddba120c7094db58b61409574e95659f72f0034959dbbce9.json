{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_server_cache_react_per_request_deduplication_react_cache", "label": "Per-Request Deduplication with React.cache()", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. Wrapping auth and DB reads in cache() collapses repeated calls across the component tree into one execution per request. Pitfall: lookup uses Object.is shallow equality, so inline object arguments never hit the cache - pass primitives or a stable reference."}, {"id": "_agents_skills_vercel_react_best_practices_rules_server_cache_react_fetch_request_memoization", "label": "Automatic fetch Request Memoization", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js already dedupes same-URL/same-options fetch calls within a request, which is why React.cache() is reserved for non-fetch async work: DB queries, heavy computation, auth checks, filesystem reads."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_server_cache_react_per_request_deduplication_react_cache", "target": "_agents_skills_vercel_react_best_practices_rules_server_cache_react_fetch_request_memoization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-react.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_server_cache_react_per_request_deduplication_react_cache", "target": "_agents_skills_vercel_react_best_practices_rules_server_auth_actions_authenticate_server_actions", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-cache-react.md", "source_location": null, "weight": 1.0}], "hyperedges": []}