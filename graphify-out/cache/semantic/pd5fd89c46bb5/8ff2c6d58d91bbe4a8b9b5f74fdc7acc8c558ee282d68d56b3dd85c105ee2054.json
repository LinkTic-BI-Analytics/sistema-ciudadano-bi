{"nodes": [{"id": "ejemplo_especificacion", "label": "Reservas de espacios comunes - Especificacion", "file_type": "document", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_i1", "label": "I1 - Un espacio nunca queda reservado dos veces (invariante suprema)", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unica cuyo incumplimiento no se puede reparar; paso dos veces con el cuaderno. Decide el orden de construccion."}, {"id": "ejemplo_especificacion_i2", "label": "I2 - Una reserva pasada no cambia", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_i3", "label": "I3 - Desistir y asignar al primero de la lista son un solo acto", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separados, la franja queda libre unos segundos y se la lleva alguien que no estaba esperando."}, {"id": "ejemplo_especificacion_i4", "label": "I4 - El derecho es del apartamento, no de la persona", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_i5", "label": "I5 - Una anulacion de la administracion nunca consume derecho", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_r1", "label": "R1 - Derecho mensual del apartamento", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "disponible = tope_mensual - confirmadas - usadas - desistidas_despues; tope 3 del conjunto. Del apartamento porque un apartamento con cuatro adultos tendria cuatro veces mas derecho."}, {"id": "ejemplo_especificacion_r2", "label": "R2 - El corte (jueves 6 p.m.)", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El corte no castiga: da tiempo a la lista de espera. Jueves y no viernes porque con viernes quien recibe el cupo no alcanza a organizarse; una sola regla para franjas entre semana por facilidad de recordar."}, {"id": "ejemplo_especificacion_r3", "label": "R3 - Lista de espera (12 horas para confirmar)", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12 horas y no 24: una franja liberada el viernes alcanza a dar dos saltos."}, {"id": "ejemplo_especificacion_r4", "label": "R4 - Bloqueos de la administracion", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_r6", "label": "R6 - Apartamentos que nunca alcanzan", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Salio del cuaderno: los mismos seis apartamentos reservaban el salon casi siempre y nadie lo veia."}, {"id": "ejemplo_especificacion_p1", "label": "P1 - Nada se inventa", "file_type": "rationale", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un estado inventado es peor que uno vacio: sin registro de deposito el salon aparece como sin registro de pago."}, {"id": "ejemplo_especificacion_p4", "label": "P4 - Quien espera primero, va primero", "file_type": "rationale", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_p5", "label": "P5 - Lo que la administracion quita no lo paga el residente", "file_type": "rationale", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_c2", "label": "C2 - Una sola verdad", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_verificacion", "label": "Seccion 9 - Como se verifica (casos calculados a mano)", "file_type": "concept", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ejemplo_especificacion_orden_frentes", "label": "Seccion 10 - Orden de los frentes", "file_type": "rationale", "source_file": "ejemplo/especificacion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frente 1 (pertenencia) primero porque no es una restriccion sobre una tabla; I1 desde el primer dia del frente 2; despues por dependencias. El frente 6 se agrego al final, no en medio."}], "edges": [{"source": "ejemplo_especificacion", "target": "ejemplo_especificacion_i1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ejemplo/especificacion.md", "source_location": null, "weight": 1.0}, {"source": "ejemplo_especificacion