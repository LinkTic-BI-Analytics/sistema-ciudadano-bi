{"nodes": [{"id": "agents", "label": "AGENTS.md \u00b7 Reglas del repositorio", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_particion_del_repositorio", "label": "\u00a71 La partici\u00f3n (negocio, metodo, mvp, linea-grafica, entregable)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_mvp_es_instrumento", "label": "\u00a72 El MVP es un instrumento, no un producto (ADR 0001)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se construye para descubrir y tirarse: no se optimiza lo que no se mantiene, pero s\u00ed se respetan las invariantes porque un MVP que las rompe ense\u00f1a un dominio falso."}, {"id": "agents_donde_vive_la_logica", "label": "\u00a78 D\u00f3nde vive la l\u00f3gica (RLS, funci\u00f3n Postgres, acci\u00f3n de servidor, funci\u00f3n de borde)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Las invariantes bajan hasta donde se vuelven imposibles, no hasta donde se validan; una invariante solo en nivel 3 la rompe un curl. Nunca la misma regla en dos niveles."}, {"id": "agents_i1_reintento_no_duplica", "label": "I1 \u00b7 Un reintento t\u00e9cnico no duplica un aporte", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L146", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_i2_no_inferir_datos", "label": "I2 \u00b7 No inferir datos que faltan", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_i4_agrupar_reversible", "label": "I4 \u00b7 Agrupar es reversible", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_i6_no_divulgar_identidad", "label": "I6 \u00b7 No divulgar identidad ni ubicaci\u00f3n sensible", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_esquema_declarativo", "label": "\u00a79 Esquema declarativo como fuente de verdad (supabase/schemas)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_borrado_logico_v11", "label": "Borrado l\u00f3gico, append-only con l\u00e1pidas (V11)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_q7_supresion_dato_personal", "label": "Q7 \u00b7 Supresi\u00f3n del dato personal", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L168", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_ley_1581_de_2012", "label": "Ley 1581 de 2012 (protecci\u00f3n de datos personales, Colombia)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L168", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_divipola_v10", "label": "Cat\u00e1logo geogr\u00e1fico DIVIPOLA del DANE (V10)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La versi\u00f3n va en cada registro (Q5) para que un corte exportado no se reescriba (R2); el lugar se guarda tambi\u00e9n con las palabras de la persona (GEO-01) para re-normalizar cuando llegue el barrio (V21)."}, {"id": "agents_pais_desde_donde_contactas", "label": "Pa\u00eds en \u00ab\u00bfdesde d\u00f3nde nos contactas?\u00bb (V27, V28, ISO 3166-1)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L203", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desde d\u00f3nde escribe alguien no es d\u00f3nde ocurre el problema; vive en columnas del aporte y no en participacion.ubicacion para no inflar el numerador de R2."}, {"id": "agents_expediente_unidad_de_decision", "label": "Expediente como unidad de decisi\u00f3n (V12)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L225", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_alerta_urgente_v13", "label": "Alerta urgente como entidad propia (V13)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L256", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mostrar un tel\u00e9fono no es haber contactado, y contactar no es que alguien haya recibido."}, {"id": "agents_tres_registros_tres_autoridades", "label": "Qui\u00e9n corrige qu\u00e9: tres registros y tres autoridades (V14, V15)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L276", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_p4_mecanismo_de_identidad", "label": "P4 \u00b7 Mecanismo de identidad (abierta)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L312", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_proceso_id", "label": "proceso_id en todas las tablas desde la primera migraci\u00f3n (Q9)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L314", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_auditoria_append_only", "label": "Auditor\u00eda append-only", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L336", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_identidad_contacto_particion", "label": "Identidad y contacto separados del dato anal\u00edtico (partici\u00f3n)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L341", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No es una vista sino una partici\u00f3n: es lo que hace cumplible que Comunicaciones no pueda descargar contactos."}, {"id": "agents_cinco_eventos_de_gestion", "label": "Recepci\u00f3n, respuesta, soluci\u00f3n, financiaci\u00f3n y ejecuci\u00f3n: cinco eventos, nunca un campo estado", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L344", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_tokens_linea_grafica", "label": "Tokens generados desde negocio/linea-grafica/tokens (DTCG)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L361", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editar el CSS generado a mano lo desincroniza del JSON, y el JSON es la fuente."}, {"id": "agents_contraste_como_compuerta", "label": "El contraste es una compuerta (41 pares, 4.5:1 / 3:1)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L364", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resoluci\u00f3n 1519 de 2020 de MinTIC obliga WCAG 2.1 AA; el sistema de dise\u00f1o apunta a 2.2 AA."}, {"id": "agents_dod_codigo", "label": "\u00a712 Definici\u00f3n de terminado \u2014 el c\u00f3digo", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L402", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un chequeo que n