{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_advanced_jsonb_indexing_jsonb_gin_indexing", "label": "Index JSONB Columns for Efficient Querying", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/advanced-jsonb-indexing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM, 10-100x faster: unindexed JSONB predicates scan the whole table. GIN indexes serve containment operators (@>, ?, ?&, ?|); a separate expression index on (attributes->>'key') is needed for specific key equality lookups because GIN does not cover them."}, {"id": "_agents_skills_supabase_postgres_best_practices_references_advanced_jsonb_indexing_jsonb_path_ops", "label": "jsonb_path_ops vs jsonb_ops Operator Class", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/advanced-jsonb-indexing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trade-off: default jsonb_ops supports all operators but builds a larger index; jsonb_path_ops supports only @> yet is 2-3x smaller."}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_advanced_jsonb_indexing_jsonb_gin_indexing", "target": "_agents_skills_supabase_postgres_best_practices_references_advanced_jsonb_indexing_jsonb_path_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/advanced-jsonb-indexing.md", "source_location": "lines 39-47", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references_advanced_jsonb_indexing_jsonb_gin_indexing", "target": "_agents_skills_supabase_postgres_best_practices_references_advanced_full_text_search_gin_index", "relation": "semantically_similar_to", "confidence": "INFERRED", "con