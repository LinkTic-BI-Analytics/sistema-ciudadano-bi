{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_move_effect_to_event_interaction_logic_in_event_handlers", "label": "Put Interaction Logic in Event Handlers", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. Modelling a user action as a boolean flag plus an effect drags unrelated values (context, theme) into the dependency array, so the side effect re-fires on changes that had nothing to do with the action. Running it in the handler keeps it once-per-interaction."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_move_effect_to_event_interaction_logic_in_event_handlers", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_dependencies_narrow_effect_dependencies", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "weight": 1.0}], "hyperedges": []}