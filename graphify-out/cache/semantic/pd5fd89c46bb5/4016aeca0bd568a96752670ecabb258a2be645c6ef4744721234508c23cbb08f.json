{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_to_constant", "label": "Extract Default Non-primitive Parameter Value to a Constant", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. A default array/function/object literal in a memoized component's parameter list creates a fresh instance on every render, so memo's strict-equality comparison always fails and memoization is silently broken. Hoisting the default to a module constant (NOOP) restores it."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_to_constant", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_extract_to_memoized_components", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_to_constant", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_no_inline_components_no_components_inside_components", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "weight": 1.0}], "hyperedges": []}