{"nodes": [{"id": "negocio_lectura_documental_documento", "label": "Lectura documental \u2014 Participaci\u00f3n Ciudadana Colombia", "file_type": "document", "source_file": "negocio/lectura-documental.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_lectura_documental_todo_propone", "label": "Todo el paquete PROPONE: nada describe un sistema que opere", "file_type": "rationale", "source_file": "negocio/lectura-documental.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modelos de datos, requisitos con c\u00f3digo e indicadores son intenci\u00f3n no comprobada; lo \u00fanico con peso de evidencia es el marco legal de la planeaci\u00f3n que ya existe."}, {"id": "negocio_lectura_documental_sistema_nacional_de_planeacion", "label": "Sistema Nacional de Planeaci\u00f3n (Ley 152 de 1994, CNP y CTP)", "file_type": "concept", "source_file": "negocio/lectura-documental.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lo que se construye no reemplaza ese mecanismo: lo alimenta. Decide que el entregable es un corte que un consejo de planeaci\u00f3n pueda recibir y verificar."}, {"id": "negocio_lectura_documental_miguel_gomez", "label": "Miguel G\u00f3mez", "file_type": "concept", "source_file": "negocio/lectura-documental.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_lectura_documental_once_roles", "label": "Once roles, diez sin confirmar (ciudadano, facilitador, revisor, analista\u2026)", "file_type": "concept", "source_file": "negocio/lectura-documental.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_lectura_documental_vocabulario", "label": "Vocabulario: aporte, necesidad situada, expediente, corte