{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rendering_hoist_jsx_hoist_static_jsx_elements", "label": "Hoist Static JSX Elements", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hoist-jsx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSX with no props or closure dependencies can be built once at module scope and reused instead of allocating a new element each render; the payoff is largest for big static SVG trees. Explicitly unnecessary when React Compiler is enabled, since the compiler hoists static JSX automatically. Impact LOW."}, {"id": "_agents_skills_vercel_react_best_practices_rules_rendering_hoist_jsx_react_compiler", "label": "React Compiler", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hoist-jsx.md", "source_location": null, "source_url": "https://react.dev/learn/react-compiler", "captured_at": null, "author": null, "contributor": null, "rationale": "Automatically hoists static JSX elements and optimizes component re-renders, which makes several manual memoization/hoisting rules redundant when it is enabled."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rendering_hoist_jsx_hoist_static_jsx_elements", "target": "_agents_skills_vercel_react_best_practices_rules_rendering_hoist_jsx_react_compiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/rendering-hoist-jsx.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_rendering_hoist_jsx_react_compiler", "target": "_agents_skills_vercel_react_best_practices_rules_js_hoist_regexp_hoist_regexp_creation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-re