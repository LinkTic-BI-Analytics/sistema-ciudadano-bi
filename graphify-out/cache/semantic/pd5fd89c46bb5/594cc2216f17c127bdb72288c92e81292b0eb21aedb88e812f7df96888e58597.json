{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_js_batch_dom_css_avoid_layout_thrashing", "label": "Avoid Layout Thrashing", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/js-batch-dom-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interleaving style writes with layout reads (offsetWidth, getBoundingClientRect, getComputedStyle) forces synchronous reflow. Batching writes then reading once, or grouping read and write phases, lets the browser coalesce style recalculation. Trade-off resolved in favor of CSS classes over inline styles because CSS files are browser-cached and classes keep separation of concerns. Impact MEDIUM."}, {"id": "_agents_skills_vercel_react_best_practices_rules_js_batch_dom_css_paulirish_layout_forcing_gist", "label": "Paul Irish: What Forces Layout/Reflow (gist)", "file_type": "document", "source_file": ".agents/skills/vercel-react-best-practices/rules/js-batch-dom-css.md", "source_location": null, "source_url": "https://gist.github.com/paulirish/5d52fb081b3570c81e3a", "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_vercel_react_best_practices_rules_js_batch_dom_css_css_triggers", "label": "CSS Triggers", "file_type": "document", "source_file": ".agents/skills/vercel-react-best-practices/rules/js-batch-dom-css.md", "source_location": null, "source_url": "https://csstriggers.com/", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_js_batch_dom_css_avoid_layout_thrashing", "target": "_agents_skills_vercel_react_best_practices_rules_js_batch_dom_css_paulirish_layout_forcing_gist", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/js-batch-dom-css.md", "source_location": null, "weight": 1.0}, {"source": "_agen