{"nodes": [{"id": "negocio_requisitos_contacto_opcional_v1", "label": "Contacto opcional, al final (requisito v1)", "file_type": "document", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_contacto_opcional_v1_miguel_gomez", "label": "Miguel G\u00f3mez (decide ampliaciones durante la construcci\u00f3n)", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_contacto_opcional_v1_identidad_contacto", "label": "Tabla identidad.contacto (valor, canal, acepta_avisos)", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existe desde la primera migraci\u00f3n pero ninguna pantalla la escribe: est\u00e1 el sitio y no est\u00e1 la puerta."}, {"id": "negocio_requisitos_contacto_opcional_v1_contacto_para_seguimiento", "label": "Contacto para seguimiento (no \u00abflujo validado\u00bb)", "file_type": "rationale", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un correo no valida identidad; llamarlo \u00abvalidado\u00bb har\u00eda pesar m\u00e1s ese aporte y crear\u00eda participaci\u00f3n de primera y de segunda. RF12 proh\u00edbe inventar identidad verificada; verificar de verdad depende de P4."}, {"id": "negocio_requisitos_contacto_opcional_v1_con_01", "label": "CON-01 \u00b7 El contacto se pide despu\u00e9s del comprobante", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primero capturar lo importante; la recepci\u00f3n no depende de nada m\u00e1s (N02, DAT-01)."}, {"id": "negocio_requisitos_contacto_opcional_v1_con_02", "label": "CON-02 \u00b7 Nada mejora por dejar contacto", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_contacto_opcional_v1_con_03", "label": "CON-03 \u00b7 Qu\u00e9 se pide (dato de contacto y c\u00f3mo llamarle) y qu\u00e9 no", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C2 y N16: una comunidad peque\u00f1a se identifica incluso sin nombre; cada dato de m\u00e1s es riesgo sin beneficio."}, {"id": "negocio_requisitos_contacto_opcional_v1_con_04", "label": "CON-04 \u00b7 El contacto se puede quitar y se borra de verdad", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V11 (borrado l\u00f3gico) no aplica: Q7 dice que quien se retira por miedo no queda protegido si la fila que lo identifica sigue ah\u00ed."}, {"id": "negocio_requisitos_contacto_opcional_v1_con_05", "label": "CON-05 \u00b7 Avisar es un acto, no una consecuencia", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_requisitos_contacto_opcional_v1_con_06", "label": "CON-06 \u00b7 Sin aviso de privacidad no se enciende", "file_type": "concept", "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Construir s\u00ed, encender no: faltan entidad responsable del tratamiento (P4/Q18), aviso de privacidad y decisi\u00f3n de conservaci\u00f3n (Q7). Mismo tipo de bloqueo que Q29."}], "edges": [{"source": "negocio_requisitos_contacto_opcional_v1", "target": "negocio_requisitos_contacto_opcional_v1_miguel_gomez", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L3", "weight": 1.0}, {"source": "negocio_requisitos_contacto_opcional_v1", "target": "negocio_requisitos_contacto_opcional_v1_identidad_contacto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L14", "weight": 1.0}, {"source": "negocio_requisitos_contacto_opcional_v1", "target": "negocio_requisitos_contacto_opcional_v1_contacto_para_seguimiento", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L37", "weight": 1.0}, {"source": "negocio_requisitos_contacto_opcional_v1", "target": "negocio_requisitos_contacto_opcional_v1_con_01", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L48", "weight": 1.0}, {"source": "negocio_requisitos_contacto_opcional_v1", "target": "negocio_requisitos_contacto_opcional_v1_con_02", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "L70", "weight": 1.0}, {"source": "negocio_requisitos_contacto_opcional_v1", "target": "negocio_requisitos_contacto_opcional_v1_con_03", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "negocio/requisitos/contacto-opcional-v1.md", "source_location": "