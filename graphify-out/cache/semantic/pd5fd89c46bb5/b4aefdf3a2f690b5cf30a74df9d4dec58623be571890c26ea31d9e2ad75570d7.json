{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_server_hoist_static_io_hoist_static_io", "label": "Hoist Static I/O to Module Level", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-hoist-static-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact HIGH. Module-level code runs once on first import, not per request, so fonts, logos, config and templates are read once instead of on every invocation; awaiting module-level promises with Promise.all keeps the handler async-safe. Not for per-request/per-user assets, files that change at runtime, very large files (memory), or sensitive data that should not persist in memory."}, {"id": "_agents_skills_vercel_react_best_practices_rules_server_hoist_static_io_fluid_compute", "label": "Vercel Fluid Compute", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/server-hoist-static-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent requests share one function instance, so module-level caching survives across requests without cold-start penalties; in traditional serverless each cold start re-executes module scope and only warm invocations reuse it."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_server_hoist_static_io_hoist_static_io", "target": "_agents_skills_vercel_react_best_practices_rules_server_hoist_static_io_fluid_compute", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/server-hoist-static-io.md", "source_location": "line 147", "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_server_hoist_static_io_hoist_static_io", "target": "_agents_skills_vercel_react_best_practices_rules_server_parallel_fetching_parallel_