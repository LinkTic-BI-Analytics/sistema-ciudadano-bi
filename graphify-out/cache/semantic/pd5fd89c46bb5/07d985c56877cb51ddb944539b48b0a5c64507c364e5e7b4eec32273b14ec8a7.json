{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references_security_privileges_least_privilege", "label": "Principle of Least Privilege for Database Roles", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-privileges.md", "source_location": "## Apply Principle of Least Privilege", "rationale": "Granting ALL (or connecting as superuser) makes any SQL injection catastrophic; narrow per-table grants composed into nologin roles bound the blast radius and leave a readable audit of who may do what. Default PUBLIC access on schema public must be revoked explicitly.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references_security_privileges_least_privilege", "target": "_agents_skills_supabase_postgres_best_practices_references_security_rls_basics_row_level_security", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/supabase-postgres-best-practices/references/security-privileges.md", "source_location": null, "weight": 1.0}], "hyperedges": []}