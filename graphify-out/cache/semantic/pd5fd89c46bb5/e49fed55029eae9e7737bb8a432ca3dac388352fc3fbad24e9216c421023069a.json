{"nodes": [{"id": "negocio_vision_documento", "label": "Participaci\u00f3n Ciudadana Colombia \u2014 visi\u00f3n del proyecto", "file_type": "document", "source_file": "negocio/vision.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_vision_promesa", "label": "La promesa: \u00abCu\u00e9ntanos qu\u00e9 necesita mejorar en tu comunidad\u2026\u00bb", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_vision_tres_formas_de_participar", "label": "Tres formas de participar: presencial, virtual en vivo, por internet sin reuni\u00f3n", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Las tres alimentan el mismo inventario de necesidades sin confundir asistencia, conversaci\u00f3n, aporte y apoyo."}, {"id": "negocio_vision_convocatorias_y_agenda", "label": "Convocatorias y agenda, con enlaces y QR por evento y pieza", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se conservan por separado el origen del enlace, el evento confirmado y el lugar del problema: escanear un QR no prueba asistencia ni dice d\u00f3nde ocurre la necesidad."}, {"id": "negocio_vision_agrupacion_explicable", "label": "Agrupaci\u00f3n explicable y corregible sin borrar lo local", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_vision_valoracion_de_senales", "label": "Valoraci\u00f3n de se\u00f1ales con pesos y reglas explicables", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La afectaci\u00f3n y la necesidad de atenci\u00f3n se analizan aparte de la confianza en los datos; el canal no demuestra que una afirmaci\u00f3n sea cierta."}, {"id": "negocio_vision_voces_que_se_pierden", "label": "Hacer visibles las voces poco frecuentes", "file_type": "rationale", "source_file": "negocio/vision.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La importancia de un problema no puede depender solo de cu\u00e1ntas personas lo repiten; un aporte grave y poco frecuente sigue teniendo ruta de examen."}, {"id": "negocio_vision_mapa_necesidades_y_cobertura", "label": "BI territorial: mapa de necesidades vs. mapa de cobertura", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La participaci\u00f3n voluntaria no representa a toda la poblaci\u00f3n; un aporte en un municipio no es haber escuchado todos sus barrios o veredas."}, {"id": "negocio_vision_campanas_de_escucha", "label": "Campa\u00f1as para ampliar la escucha (brecha \u2192 causa \u2192 acci\u00f3n \u2192 evaluaci\u00f3n)", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_vision_tarjeta_yo_aporte", "label": "Tarjeta \u00abYo aport\u00e9\u00bb como moneda social", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "negocio_vision_publico_vs_interno", "label": "Lo p\u00fablico y el trabajo interno, separados", "file_type": "concept", "source_file": "negocio/vision.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributo