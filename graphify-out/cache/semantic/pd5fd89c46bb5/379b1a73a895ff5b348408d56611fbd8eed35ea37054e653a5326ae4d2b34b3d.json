{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_extract_to_memoized_components", "label": "Extract to Memoized Components", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-memo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact MEDIUM. Hooks cannot sit behind an early return, so a useMemo in the parent still runs during loading states; moving the expensive work into a memo() child lets the parent return the skeleton before the computation is ever reached."}, {"id": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_react_compiler", "label": "React Compiler Auto-Memoization", "file_type": "concept", "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-memo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When enabled, the compiler optimizes re-renders automatically, so manual memo()/useMemo and some dependency-splitting become unnecessary; functional setState is still recommended for correctness."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_extract_to_memoized_components", "target": "_agents_skills_vercel_react_best_practices_rules_rerender_memo_react_compiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/rerender-memo.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "referential_stability_for_memoization", "label": "Referential Stability as a Precondition for Memoization", "nodes": ["_agents_skills_vercel_react_best_practices_rules_rerender_memo_extract_to_memoized_components", "_agents_skills_vercel_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_to_constant", "_agents_skills_vercel_react_best_prac