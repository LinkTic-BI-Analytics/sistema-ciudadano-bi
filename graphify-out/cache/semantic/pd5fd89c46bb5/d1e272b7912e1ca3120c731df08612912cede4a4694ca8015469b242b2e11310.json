{"nodes": [{"id": "_agents_skills_supabase_postgres_best_practices_references__contributing_writing_guidelines", "label": "Writing Guidelines for Postgres References", "file_type": "document", "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guidelines are shaped for LLM/agent consumption: concrete SQL rewrites over philosophical advice, semantic table/column names because names carry intent for LLMs, SQL-only by default for portability (application code only for pooling, transactions, ORM N+1 and prepared statements), and comments that explain why rather than what."}, {"id": "_agents_skills_supabase_postgres_best_practices_references__contributing_error_first_structure", "label": "Error-First Structure (Incorrect then Correct)", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always show the problematic pattern before the solution because it trains agents to recognize anti-patterns."}, {"id": "_agents_skills_supabase_postgres_best_practices_references__contributing_quantified_impact", "label": "Quantified Impact Requirement", "file_type": "rationale", "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specific metrics ('10x faster queries', '50% smaller index') instead of 'faster' or 'better' let agents prioritize which fixes to apply first."}, {"id": "_agents_skills_supabase_postgres_best_practices_references__contributing_impact_level_guidelines", "label": "Impact Level Scale (CRITICAL to LOW)", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CRITICAL = 10-100x, HIGH = 5-20x, MEDIUM-HIGH = 2-5x, MEDIUM = 1.5-3x, LOW-MEDIUM = 1.2-2x, LOW = incremental; the scale ties a rule's declared impact to a measurable speedup band."}], "edges": [{"source": "_agents_skills_supabase_postgres_best_practices_references__contributing_writing_guidelines", "target": "_agents_skills_supabase_postgres_best_practices_references__contributing_error_first_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": "section 2", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references__contributing_writing_guidelines", "target": "_agents_skills_supabase_postgres_best_practices_references__contributing_quantified_impact", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": "section 3", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references__contributing_writing_guidelines", "target": "_agents_skills_supabase_postgres_best_practices_references__contributing_impact_level_guidelines", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/_contributing.md", "source_location": "Impact Level Guidelines table", "weight": 1.0}, {"source": "_agents_skills_supabase_postgres_best_practices_references__contributing_writing_guidelines", "target": "_agents_skills_supabase_postgres_best_practices_references_data_n_plus_one_eliminate_n_plus_one", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/