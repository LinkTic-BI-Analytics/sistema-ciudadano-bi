{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_js_index_maps_build_index_maps_for_repeated_lookups", "label": "Build Index Maps for Repeated Lookups", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/js-index-maps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated .find() by the same key is O(n) per lookup inside an O(n) map, i.e. quadratic. Building a Map keyed by id once costs O(n) and makes every lookup O(1): for 1000 orders x 1000 users, 1M ops become 2K ops. Impact LOW-MEDIUM."}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_js_index_maps_build_index_maps_for_repeated_lookups", "target": "_agents_skills_vercel_react_best_practices_rules_js_set_map_lookups_use_set_map_for_o1_lookups", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/vercel-react-best-practices/rules/js-index-maps.md", "source_location": null, "weight": 1.0}], "hyperedges": []}