{"nodes": [{"id": "_agents_skills_vercel_react_best_practices_rules_async_defer_await_defer_await_until_needed", "label": "Defer Await Until Needed", "file_type": "rationale", "source_file": ".agents/skills/vercel-react-best-practices/rules/async-defer-await.md", "source_location": "## Defer Await Until Needed", "rationale": "Hoisted awaits block branches that never use the value; pushing the await into the branch that consumes it (and ordering early-return guards before expensive fetches) pays off most when the skipped branch is the common one or the deferred operation is expensive.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_vercel_react_best_practices_rules_async_defer_await_defer_await_until_needed", "target": "_agents_skills_vercel_react_best_practices_rules_async_cheap_condition_before_await_check_cheap_conditions_before_async_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/vercel-react-best-practices/rules/async-defer-await.md", "source_location": "see [Check Cheap Conditions Before Async Flags](./async-cheap-condition-before-await.md)", "weight": 1.0}, {"source": "_agents_skills_vercel_react_best_practices_rules_async_defer_await_defer_await_until_needed", "target": "_agents_skills_vercel_react_best_practices_rules_bundle_conditional_conditional_module_loading", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/vercel-react-best-practices/rules/async-defer-await.md", "source_location": "the same laziness principle across two cost axes: pay for the fetch only on the branch that consumes it, pay for the module only when the feature is on", "weight": 1.0}], "hyperedges": []}